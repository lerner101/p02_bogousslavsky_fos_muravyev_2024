# This file serves as an example of what your .env file should look like.
# Replace the variables defined here with those applicable on your own system.
# Then copy the contents into a file called ".env" and place it in project's
# root directory. 

WRDS_USERNAME=jdoe

# The collector reads WRDS_USERNAME from .env. Keep the WRDS password in your
# own libpq password file, not here or in Git. See the data acquisition guide.
# Optional: PGPASSFILE=/absolute/path/to/your/password/file
# Settings fall back to these directory defaults. Collection scripts currently
# save to the repository's _data/ folder. Relative paths are from the repo root.
# The doit research build currently requires these default paths; custom path
# overrides are rejected until all source readers support them consistently.
DATA_DIR=_data
OUTPUT_DIR=_output
